{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stewarthaines/seed-html/extensions/family-history/person.schema.json",
  "title": "Person record",
  "description": "A chapter's frontmatter record for the family-history extension: the chapter's own person, plus an `others:` map of records for relatives who have no chapter. Keys were inventoried from two books (process/CHAPTER_FRONTMATTER.md); anything else is a finding.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "description": "A person id — a chapter idref when the person has a chapter, otherwise the key of their `others:` record."
    },
    "date": {
      "description": "An EDTF (ISO 8601-2) date — 1922, 1922-12, 1922-12-04, 187X-08-22, 1837?, 1837~, 1866/1868, /1948 — or a bare integer year.",
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9999 },
        {
          "type": "string",
          "pattern": "^(?:(?:\\d{4}|\\d{3}X|\\d{2}XX)(?:-(?:\\d{2}|XX)(?:-(?:\\d{2}|XX))?)?[?~%]?(?:/(?:(?:\\d{4}|\\d{3}X|\\d{2}XX)(?:-(?:\\d{2}|XX)(?:-(?:\\d{2}|XX))?)?[?~%]?|\\.\\.)?)?|(?:\\.\\.)?/(?:\\d{4}|\\d{3}X|\\d{2}XX)(?:-(?:\\d{2}|XX)(?:-(?:\\d{2}|XX))?)?[?~%]?)$"
        }
      ]
    },
    "partnership": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "married": { "$ref": "#/$defs/date" },
        "married_place": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "partner": {
      "description": "One partner as an id (with the record's own `married` / `married_place`), or a list of partners in order, each an id or { id, married, married_place }.",
      "anyOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [{ "$ref": "#/$defs/id" }, { "$ref": "#/$defs/partnership" }]
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "display": { "type": "string" },
        "nickname": { "type": "string" },
        "birth": { "$ref": "#/$defs/date" },
        "death": { "$ref": "#/$defs/date" },
        "birthplace": { "type": "string" },
        "deathplace": { "type": "string" },
        "parents": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "maxItems": 2
        },
        "partner": { "$ref": "#/$defs/partner" },
        "married": { "$ref": "#/$defs/date" },
        "married_place": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "display": { "type": "string" },
    "nickname": { "type": "string" },
    "birth": { "$ref": "#/$defs/date" },
    "death": { "$ref": "#/$defs/date" },
    "birthplace": { "type": "string" },
    "deathplace": { "type": "string" },
    "parents": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1,
      "maxItems": 2
    },
    "partner": { "$ref": "#/$defs/partner" },
    "married": { "$ref": "#/$defs/date" },
    "married_place": { "type": "string" },
    "others": {
      "type": "object",
      "description": "Records for relatives without a chapter, keyed by id. A bare null is an id with no facts yet.",
      "additionalProperties": {
        "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/record" }]
      }
    }
  },
  "additionalProperties": false
}
